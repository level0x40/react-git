# Dev caches generated by running the CLI / templates locally. These
# live under app/ (close to where the build runs) so node_modules
# resolution works at runtime, but they must NEVER ship in the
# published tarball — they include Vite's cache, the build scratch
# tree, and other transient state with broken symlinks that trip
# tarball packers.
.react-git
.react-server

# Vite caches that can also appear under app/ during dev iterations.
.vite
node_modules

# Build outputs (when someone runs `react-git build` from this dir
# and the default --out=./dist lands inside the package).
dist

# Logs and OS junk.
.DS_Store
*.log

# Lock files of nested workspaces / scratch reproductions if any
# accidentally land here. The published package's deps are resolved
# from the consumer's lockfile, not ours.
pnpm-lock.yaml
yarn.lock
package-lock.json
