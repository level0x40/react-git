# Refuse to install with a non-pinned package manager. Combined with the
# `packageManager` field in package.json, this forces every contributor
# to use the same pnpm version (via corepack) so lockfile churn isn't
# caused by tooling drift.
engine-strict=true

# Don't let `pnpm install` accidentally update the lockfile when
# resolving an unmet peer dep — keeps reproducible installs.
auto-install-peers=false
